# ---------------------------------------------------------------------------
# Quest 3 diagnostics -- what stays out of git, and why.
# ---------------------------------------------------------------------------

# Wire captures: 30-120 MB per run, no textual diff value, regenerable by re-running a cell.
runs/**/cap.pcapng
runs/**/cap.etl

# Machine-bound credentials: Virtual Desktop's DPAPI blobs (ProtectedComputerID,
# Accounts.OculusQuest) are user+machine scoped secrets. Never publish.
**/pc_config.json

# This rig's profile: real paths, IPs, SSIDs. Tracked template is site.example.json.
tools/site.json

# Harness runtime state (written while a cell runs).
tools/current_run_id.txt
tools/elev-cmd.txt
tools/elev-do-cmd.txt
tools/elev-res.txt
tools/elev-do-res.txt
tools/elev-setup-log.txt
tools/*.log

# Raw adb device dumps: regenerate with tools/Quest-Probe.ps1. They carry the
# headset serial/MACs and neighbors' SSIDs/BSSIDs from scan lists.
probe/**/raw/
probe/**/*-raw/

# AP administration screenshot with the Wi-Fi passphrase rendered in plaintext.
topology/ap-radio.png

# Third-party aarch64 Android build of iperf3 (BSD-3-Clause). Fetch or build your own.
tools/iperf3.*

# Third-party PresentMon console-app build (MIT). Fetch your own from
# https://github.com/GameTechDev/PresentMon/releases/latest and point presentmon_exe at it.
tools/vendor/

# Raw PresentMon per-frame capture (regenerable by re-running a monitored session with
# presentmon_exe configured); the reduced pc_game_fps_* fields land in results.json/results.csv instead.
runs/**/presentmon.csv

# Fingerprint baselines are this rig's own "current normal" per configuration (AP, driver, OS build),
# not a portable measurement -- regenerate with `cell.py fingerprint <run_id> --save-baseline`.
baseline/fingerprints/

# Private/scratch runs: any run_id you prefix with "priv_" (e.g. priv_ram3600_...) is a personal
# sanity-check, not part of the published dataset. `cell.py results`/`passive` already skip its row in
# the tracked results.csv for the same reason (see is_private_run() in tools/cell.py) -- this covers the
# rest of the run directory (TSVs, results.json, fingerprint_diff.json, ...).
runs/priv_*/

# Python
__pycache__/
*.py[cod]
